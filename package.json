{
  "name": "eyesclose",
  "private": true,
  "version": "0.0.0",
  "description": "A digital cleanup kit for families after a death. Runs in the browser and keeps answers on the device.",
  "workspaces": [
    "web",
    "server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate -w server -- up"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.74.0"
  }
}
